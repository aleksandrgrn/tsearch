# =========================
# Minimal project-only repo
# =========================

# --- dependencies ---
node_modules/

# --- environment / secrets ---
.env
.env.*
!.env.example

# --- logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS junk ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- caches / temp ---
.cache/
tmp/
temp/
*.tmp
.npm/
.eslintcache
*.tsbuildinfo
coverage/

# --- python (if any) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- build artifacts (keep dist/, but ignore sourcemaps) ---
dist/**/*.map
dist/**/*.LICENSE.txt

# =========================
# Exclude agent/process/tooling
# =========================
.agent/
.clinerules/
execution/

AGENTS.md
CONTINUITY.md
FIRST_README.md

# Optional: exclude extra local helper files if you don't want them in the repo
requirements.txt
