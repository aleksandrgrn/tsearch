{
    "manifest_version": 3,
    "minimum_chrome_version": "88",
    "action": {
        "default_icon": {
            "19": "assets/icons/icon_19.png",
            "38": "assets/icons/icon_38.png"
        },
        "default_title": "Torrents MultiSearch",
        "default_popup": "popup.html"
    },
    "icons": {
        "128": "assets/icons/icon_128.png",
        "48": "assets/icons/icon_48.png",
        "16": "assets/icons/icon_16.png"
    },
    "options_page": "index.html#/options",
    "optional_permissions": [
        "tabs"
    ],
    "permissions": [
        "storage",
        "contextMenus",
        "unlimitedStorage",
        "scripting",
        "offscreen"
    ],
    "host_permissions": [
        "*://thepiratebay.org/*",
        "*://rutracker.org/*",
        "*://extratorrent.si/*",
        "*://booktracker.org/*",
        "*://pb.wtf/*",
        "*://izhtorrent.ru/*",
        "*://nnmclub.to/*",
        "*://kinozal.tv/*",
        "*://inmac.org/*",
        "*://rutor.info/*",
        "*://tfile.co/*",
        "*://tapochek.net/*",
        "*://rgfootball.net/*",
        "*://piratebit.net/*",
        "*://opentorrent.ru/*",
        "*://megashara.com/*",
        "*://brodim.com/*",
        "*://suggestqueries.google.com/*",
        "*://www.google.com/*",
        "*://www.google-analytics.com/*",
        "*://*.tfile1.cc/*",
        "*://tfile1.cc/*",
        "*://*.imdb.com/*",
        "*://*.kinopoisk.ru/*",
        "*://gameguru.ru/*",
        "*://*.gameguru.ru/*",
        "*://sso.passport.yandex.ru/*"
    ],
    "omnibox": {
        "keyword": "tms"
    },
    "background": {
        "service_worker": "bg.js"
    },
    "sandbox": {
        "pages": [
            "sandbox.html"
        ]
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'",
        "sandbox": "sandbox allow-scripts allow-forms allow-popups; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"
    },
    "name": "__MSG_extName__",
    "description": "__MSG_extDesc__",
    "default_locale": "en",
    "version": "3.1.2"
}
